{
  "name": "vyro",
  "version": "1.0.0",
  "packageManager": "yarn@1.22.19",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:push": "npm run db:push --workspace=@vyro/database",
    "db:studio": "npm run db:studio --workspace=@vyro/database",
    "db:generate": "npm run db:generate --workspace=@vyro/database"
  },
  "devDependencies": {
    "turbo": "*",
    "typescript": "*"
  }
}
