{
  "name": "vyro",
  "version": "1.0.0",
  "packageManager": "yarn@1.22.19",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "yarn workspace @vyro/database db:generate",
    "start": "yarn workspace api start",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:push": "yarn workspace @vyro/database db:push",
    "db:studio": "yarn workspace @vyro/database db:studio",
    "db:generate": "yarn workspace @vyro/database db:generate"
  },
  "devDependencies": {
    "@types/node": "*",
    "prisma": "*",
    "turbo": "*",
    "typescript": "*"
  }
}
