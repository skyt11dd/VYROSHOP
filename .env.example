# 1. DATABASE (PostgreSQL)
# Required for packages/database
DATABASE_URL="postgresql://user:password@localhost:5432/vyro?schema=public"

# 2. JWT SECRET
# Required for apps/api
JWT_SECRET="super_secret_jwt_key_for_vyro_platform_change_me_in_production"

# 3. TELEGRAM BOT
# Required for apps/telegram-bot
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
MINI_APP_URL="https://mini.vyro.store" # Or your localhost/ngrok URL for testing
CRM_URL="https://crm.vyro.store"

# 4. FRONTEND URLs (for local dev)
# Required for apps/website, apps/crm, apps/telegram-mini-app
NEXT_PUBLIC_API_URL="http://localhost:4000"
